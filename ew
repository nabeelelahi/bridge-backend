const resetPasswordAdmin = (req, res) => {
  const { token, id, newPassword } = req.body

  sql.customQuery(`SELECT * FROM token WHERE adminId = '${id}'`, (result, isError) => {
    if (isError) {
      res.json({
        success: false,
        message: result
      })
    } else {


      currentTime = new Date();
      let timeDiff = currentTime - new Date(result[0].createdAt); //in ms
      timeDiff /= 1000;

      // get seconds 
      let seconds = Math.round(timeDiff);

      if (seconds > 30) {
        res.json({
          success: false,
          message: 'link expired'
        })
      } else {
        sql.customQuery(
          `UPDATE admin
      SET password = '${newPassword}'
      WHERE adminId = '${id}'`,
          (result, isError) => {
            if (isError) {
              res.json({
                success: false,
                message: result
              })
            } else {
              res.json({
                success: true,
                message: 'password reset successfully'
              })
            }
          }
        )
      }
    }
  })
  return res
}

const generateMemberRegistrationFormLink = (req, res) => {
  const { adminId, email } = req.params
  try {
    sql.customQuery(`SELECT * FROM member WHERE memberEmail = '${email}'`, async (result, isError) => {

      if (isError) {
        res.json({
          success: false,
          message: result
        })
      } else {
        if (result?.length) {
          sql.customQuery(`SELECT * FROM admin WHERE adminId = '${adminId}'`, async (result0, isError) => {

            if (isError) {
              res.json({
                success: false,
                message: result0
              })
            } else {
              if (result0?.length) {
                sql.customQuery(`SELECT * FROM registration_links WHERE adminId = '${adminId}' AND email = '${email}' AND isActive = 'TRUE'`, async (result1, isError) => {

                  if (isError) {
                    res.json({
                      success: false,
                      message: result1
                    })
                  } else {
                    sql.customQuery(`UPDATE registration_links SET isActive = 'FALSE' WHERE 
                      adminId = '${adminId}' AND email = '${email}' AND isActive = 'TRUE'`, async (result2, isError) => {

                      if (isError) {
                        res.json({
                          success: false,
                          message: result2
                        })
                      } else {
                        const bcryptSalt = 10;
                        let registrationFormToken = crypto.randomBytes(32).toString("hex");
                        // const hash = await bcrypt.hash(registrationFormToken, Number(bcryptSalt));
                        const formLink = `${PROD_BASEURL}/GET/member/registration/form?token=${registrationFormToken}&id=${adminId}&email=${email}`;

                        sql.customQuery(`INSERT INTO registration_links (adminId, email, formLink, token, isActive, createdAt)
                        
                        VALUES ('${adminId}', '${email}', '${formLink}', '${registrationFormToken}', 'TRUE', '${new Date()}')`, (result3, isError) => {

                          if (isError) {
                            res.json({
                              success: false,
                              message: result3
                            })
                          }
                          else {
                            mail("registrationFormLink", { email, formLink }).then((isEmailSent) => {
                              console.log(isEmailSent, "Email Sent Response")
                              res.json({
                                success: true,
                                message: `email has been sent to ${email}`
                              })
                            })
                          }
                        })
                      }
                    })
                  }
                })

              } else {
                res.json({
                  success: false,
                  message: "no such admin"
                })
              }
            }
          })
        } else {
          res.json({
            success: false,
            message: "member email doesnot exist"
          })
        }
      }
    })
  } catch (error) {
    res.json({ success: false, message: error })
  }

  return res
}

const renderMemberRegistrationFormView = (req, res) => {
  const { token, id, email } = req.query

  sql.customQuery(`SELECT * FROM registration_links WHERE adminId = '${id}' AND token = '${token}' AND isActive = 'TRUE'`, async (result, isError) => {
    if (isError) {
      res.json({
        success: false,
        message: result
      })
    } else {

      if (result?.length) {
        currentTime = new Date();
        let timeDiff = currentTime - new Date(result[0]?.createdAt); //in ms
        timeDiff /= 1000;

        // get seconds 
        let seconds = Math.round(timeDiff);

        if (seconds > 3600) {
          res.json({
            success: false,
            message: 'link expired'
          })
        } else {
          return res.render('member-registration-form-template', { token, id, email })
        }
      } else {
        res.json({
          success: false,
          message: 'link not valid'
        })
      }
    }
  })
}